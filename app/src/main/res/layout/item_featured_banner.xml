<?xml version="1.0" encoding="utf-8"?>
<!-- Featured Banner Item — hiển thị đầu trang, full-width, 300dp tall -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="300dp"
    android:layout_marginBottom="8dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:focusable="true"
    android:clickable="true">

    <!-- Background banner image -->
    <ImageView
        android:id="@+id/featured_banner_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:background="@drawable/bg_card_hdmi"/>

    <!-- Bottom gradient overlay for text readability -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_featured_gradient"/>

    <!-- Glow border on focus -->
    <com.milauncher.util.GlowShadowView
        android:id="@+id/featured_glow"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"/>

    <!-- Content at bottom -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="20dp">

        <TextView
            android:id="@+id/featured_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFFFF"
            android:textSize="26sp"
            android:textStyle="bold"
            android:shadowColor="#CC000000"
            android:shadowDx="2" android:shadowDy="2" android:shadowRadius="6"
            android:text="YouTube"/>

        <TextView
            android:id="@+id/featured_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#AAFFFFFF"
            android:textSize="14sp"
            android:layout_marginTop="4dp"
            android:shadowColor="#AA000000"
            android:shadowDx="1" android:shadowDy="1" android:shadowRadius="4"
            android:text="Mở ứng dụng"/>

    </LinearLayout>

    <!-- Play button indicator (right side) -->
    <ImageView
        android:id="@+id/featured_play_icon"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center_vertical|end"
        android:layout_marginEnd="32dp"
        android:src="@android:drawable/ic_media_play"
        android:alpha="0"
        android:scaleType="centerInside"/>

</FrameLayout>
